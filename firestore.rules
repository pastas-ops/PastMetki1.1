rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /logins/{l} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /profiles/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }
    match /users/{u} {
      allow read, write: if request.auth != null && request.auth.uid == u;
    }
    match /chats/{c} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      match /msgs/{m} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
      }
    }
  }
}
